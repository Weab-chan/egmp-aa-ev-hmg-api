{
  "id": "egmp-aa-ev",
  "name": "EV routing for Android Auto (Ioniq 6 + EV6 Canada test)",
  "version": "0.5.1-beta.102",
  "hmgapi": ">=1.1.0-beta.1",
  "authors": [
    "willemcvu",
    "AwsomeFox"
  ],
  "license": "AGPL-3.0",
  "description": "Canadian Ioniq 6 and Kia EV6 260206 test add-on for the working wireless beta.101 setup. Live battery data and Google Maps EV routing. Preconditioning defaults off; existing settings survive updates, so turn it off before the first test. This combined build needs in-car validation.",
  "requires": [
    "wireless-carplay-aa >=2.2.0-beta.101"
  ],
  "system": [
    {
      "model": [
        "CEEV",
        "CVEV"
      ],
      "region": "CAN",
      "firmware": [
        "260206"
      ]
    }
  ],
  "hooks": {
    "jar": "hooks.jar",
    "entry": "com.google.android.projection.protocol.HmgApiEntry",
    "points": {
      "gpm.sensor_source.init": "change",
      "gpm.receiver.destroy": "observe",
      "gpm.receiver_service.disconnected": "observe",
      "gpm.navigation_status.next_turn": "observe",
      "gpm.navigation_status.status": "observe"
    },
    "native": {
      "libautoreceiver_infobank.so": [
        "recipes/ev-sensor-48ee793a.recipe",
        "recipes/ev-sensor-dbfe7bd2.recipe"
      ]
    }
  },
  "projection": {
    "aa_fuel_types": [
      10
    ],
    "aa_ev_connectors": [
      4,
      1
    ]
  },
  "vehicle": {
    "commands": [
      "conditioning"
    ]
  },
  "usb": [
    "egmp-aa-ev-logs"
  ],
  "services": [
    {
      "name": "relay",
      "jar": "relay.jar",
      "class": "dev.egmp.aaev.RelayService",
      "user": "system"
    },
    {
      "name": "offload",
      "script": "scripts/offload.sh",
      "user": "root"
    }
  ],
  "logs": {
    "tags": [
      "EvModelSender",
      "EvDriveLog",
      "EvLogger",
      "EvCar",
      "EvPrecond",
      "EvLiveData"
    ],
    "match": [
      "[egmp-aa-ev]"
    ]
  }
}
